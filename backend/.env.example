# =====================================================================
# Motorsport Analytics - variables de entorno del backend
# Copiar este archivo como ".env" (no se sube a git) y completar los valores.
# =====================================================================
# --- Base de datos PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/motorsport_test
DB_USERNAME=
DB_PASSWORD=

# --- Seguridad ---
# Clave para firmar los JWT: minimo 32 caracteres aleatorios.
# Generar una con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=240
# Emails (separados por coma) que tendran rol ADMIN al iniciar sesion
ADMIN_EMAILS=admin@ejemplo.com,mateo1@prueba.com

# --- CORS: URL(s) del frontend permitidos, separados por coma ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Integracion con APIs externas (opcionales, tienen valores por defecto) ---
# INTEGRACION_TIMEOUT_CONEXION_MS=5000
# INTEGRACION_TIMEOUT_LECTURA_MS=20000
# INTEGRACION_REINTENTOS=3
# F1_JOLPICA_URL_BASE=https://api.jolpi.ca/ergast/f1/
# WRC_URL_BASE=https://p-p.redbull.com/rb-wrccom-lintegration-yv-prod/api/
# WRC_HABILITADO=true
# Sincronizacion automatica diaria de la temporada actual
SYNC_AUTOMATICA=false
# SYNC_CRON=0 0 6 * * *